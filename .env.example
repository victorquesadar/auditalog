# ============================================================
# AuditaLog · Variables de entorno (ejemplo)
# ============================================================
# Copiar este archivo a `.env` y completar con credenciales reales.
# NO versionar `.env` (ya está en .gitignore).

# ---------- App ----------
APP_ENV=dev                   # dev | prod
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET=change-me          # usada por FastAPI para sesiones

# ---------- MongoDB (Atlas o local) ----------
# Atlas: cluster en AWS Oregon, acceso solo desde la IP del servidor del curso.
MONGO_URI=mongodb+srv://usuario:password@cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=auditalog

# ---------- Redis ----------
# Si usan el Redis compartido del curso, respetar el prefijo grupo4:
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_PREFIX=grupo4:auditalog:

# ---------- SQLite (paquete de evidencia) ----------
SQLITE_EXPORT_DIR=./data/exports

# ---------- Reglas de detección (configurables) ----------
RULE_BRUTEFORCE_WINDOW_SEC=600       # 10 min
RULE_BRUTEFORCE_MAX_FAILS=5          # 5 fallos → alerta
RULE_OFFHOURS_START=22               # 22:00
RULE_OFFHOURS_END=6                  # 06:00
RULE_CONFIG_PATHS=/etc/,/usr/local/etc/

# ---------- Loghub (dataset de prueba) ----------
LOGHUB_DIR=./data/loghub
