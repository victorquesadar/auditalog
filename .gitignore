# Entorno
.env
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# SQLite (no versionar bases grandes; se recrean con scripts/)
*.db
*.db-journal
*.db-wal
*.db-shm
!data/samples/*.db  # bases pequeñas de ejemplo sí pueden ir

# Logs crudos y datos grandes
data/raw/
data/loghub/
*.log

# IDEs
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Pruebas y coverage
.pytest_cache/
.coverage
htmlcov/

# Builds
dist/
build/
*.egg-info/

# Docker
docker-compose.override.yml

# ------------------------------------------------------------------
# Bases GeoIP: cada desarrollador las descarga local con
#   python scripts/download_geoip.py
# No se versionan por tamaño y porque la licencia MaxMind no permite
# redistribución libre. DB-IP Lite (default) tiene una licencia CC-BY
# más permisiva pero igual no corresponde en el repo.
# ------------------------------------------------------------------
data/geoip/*.mmdb
data/geoip/*.tar.gz

# Dump de Redis que puede quedar al correr tests sin daemonize
dump.rdb
